# =========================================================
# CompiTek – Einstellungen für Apache-Webserver
# (bei den meisten deutschen Webhostern wie IONOS, Strato,
#  all-inkl. automatisch aktiv; bei GitHub Pages wirkungslos)
# =========================================================

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Immer verschlüsselt (https) und ohne "www.":
  # Viele Hoster erledigen das bereits per Schalter im Kundenmenü.
  # Nur einkommentieren, wenn nicht – und danach testen.
  # RewriteCond %{HTTPS} off [OR]
  # RewriteCond %{HTTP_HOST} ^www\. [NC]
  # RewriteRule ^ https://compitek.de%{REQUEST_URI} [L,R=301]

  # Alte Adressen der bisherigen Seite auf die neuen umleiten,
  # damit Google-Treffer und Lesezeichen weiter funktionieren.
  # TODO: Liste vervollständigen, sobald alle alten Adressen bekannt sind.
  RewriteRule ^service\.html$                /#leistungen      [R=301,L,NE]
  RewriteRule ^preise\.html$                 /#preise          [R=301,L,NE]
  RewriteRule ^kontakt\.html$                /#kontakt         [R=301,L,NE]
  RewriteRule ^infos/kontakt\.html$          /#kontakt         [R=301,L,NE]
  RewriteRule ^infos/oeffnungszeiten\.html$  /#kontakt         [R=301,L,NE]
  RewriteRule ^agbs\.html$                   /agb.html         [R=301,L]

  # /index.html -> / (nur bei direktem Aufruf, sonst Endlosschleife)
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]
</IfModule>

# Komprimierung
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>

# Zwischenspeichern im Browser
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
